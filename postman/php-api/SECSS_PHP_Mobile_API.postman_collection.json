        {
          "name": "Login - ADMINISTRADOR (Steven) [PHP API]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mobile/v1/auth/storeAuthLogin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mobile",
                "v1",
                "auth",
                "storeAuthLogin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero_documento\": \"{{docAdmin}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const data = pm.response.json();",
                  "pm.test(\"devuelve token\", () => pm.expect(data.token).to.be.a('string'));",
                  "if (data.token) pm.environment.set('tokenAdmin', data.token);",
                  "if (data.usuario) pm.environment.set('tokenAdmin_userId', data.usuario.id);"
                ]
              }
            }
          ]
        },
